rules_version = '2'; service cloud.firestore { match /databases/{database}/documents { function signedIn(){return request.auth != null;} function admin(){return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));} match /ipos/{id}{allow read: if true; allow write: if admin();} match /admins/{uid}{allow read: if signedIn() && request.auth.uid == uid; allow write: if false;} match /users/{uid}/{document=**}{allow read,write: if signedIn() && request.auth.uid == uid;} } }
